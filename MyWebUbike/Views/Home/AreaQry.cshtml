@{
    ViewData["Title"] = "YouBike 行政区域查询";
    var result = ViewBag.Result as UbikeAreaQueryResponseDto;
    var area = ViewBag.Area as string ?? "";
    var error = ViewBag.Error as string;
}

<div class="container mt-4">
    <h2 class="mb-4">YouBike 行政区域查询</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form method="post" asp-action="AreaQry">
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <label for="area">行政区域名称：</label>
                            <input type="text" class="form-control" id="area" name="area" 
                                   value="@area" placeholder="例如：大安區、中正區" required>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">查询</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (result != null)
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">查询结果 - @result.Area</h5>
                <small class="text-muted">共找到 @result.Count 个站点</small>
            </div>
            <div class="card-body">
                @if (result.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>站點編號</th>
                                    <th>站點名稱</th>
                                    <th>行政區域</th>
                                    <th>可借車輛</th>
                                    <th>可還空位</th>
                                    <th>總停車格</th>
                                    <th>狀態</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var station in result.Stations)
                                {
                                    <tr>
                                        <td>@station.Sno</td>
                                        <td>@station.Sna</td>
                                        <td>@station.Sarea</td>
                                        <td>
                                            <span class="badge bg-success">@station.AvailableRentBikes</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@station.AvailableReturnBikes</span>
                                        </td>
                                        <td>@station.Quantity</td>
                                        <td>
                                            @if (station.Act == "1")
                                            {
                                                <span class="badge bg-success">营运中</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">暂停服务</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        未找到指定行政区域的站点数据。
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 可以在这里添加额外的 JavaScript 功能
    </script>
}

